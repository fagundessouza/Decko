# Modelo do ambiente local. Copie para `.env` e preencha.
#
# `.env` NUNCA é commitado — regra 3 do CLAUDE.md. Este arquivo existe para dizer quais
# variáveis existem, sem carregar nenhum valor real.

DECKO_ENV=development
DECKO_DEBUG=true

# ---------------------------------------------------------------- banco
#
# Dois papéis, e a separação é o que faz o isolamento entre empresas funcionar:
#
#   decko_owner  dono do schema, usado APENAS pelas migrações
#   decko_app    usado pela aplicação; não é dono e não tem BYPASSRLS, então as políticas
#                de Row Level Security se aplicam a ele
#
# `GET /health` informa com qual papel a API conectou e se ele ignora RLS. Se
# `bypasses_rls` vier `true`, o isolamento entre empresas não está valendo.

DECKO_DATABASE_URL=postgresql+asyncpg://decko_app:TROQUE@localhost:5432/decko
DECKO_MIGRATION_DATABASE_URL=postgresql+psycopg://decko_owner:TROQUE@localhost:5432/decko

# Conexões mantidas com o banco. Cada uma custa memória **no PostgreSQL** também: subir
# sem olhar o `max_connections` do servidor troca um limite por outro.
DECKO_DB_POOL_SIZE=10
DECKO_DB_MAX_OVERFLOW=5

# ---------------------------------------------------------------- sessão

# Assina os tokens. Gere um valor próprio e longo; trocar derruba todas as sessões.
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
DECKO_SECRET_KEY=TROQUE-POR-UM-VALOR-PROPRIO-E-LONGO

# ---------------------------------------------------------------- origens

# Quem pode chamar a API de **outro domínio**, separado por vírgula.
#
# Vazio é o padrão e quer dizer nenhuma — que é o certo em desenvolvimento, onde o proxy
# do Vite encaminha `/api` e não há requisição entre origens.
#
# Preencha quando a tela for servida de outro lugar, por exemplo:
#   DECKO_CORS_ORIGINS=https://decko.vercel.app,http://localhost:5173
DECKO_CORS_ORIGINS=

# ---------------------------------------------------------------- senha vazada

# Confere a senha escolhida contra vazamentos conhecidos, por k-anonimato: só os cinco
# primeiros caracteres do SHA-1 saem daqui. Desligue em instalação sem internet, onde a
# consulta é latência garantida sem resposta possível.
# Ver docs/adr/0011-senha-conhecidamente-vazada.md.
DECKO_BREACH_CHECK_ENABLED=true

# ---------------------------------------------------------------- front
#
# As variáveis abaixo são do `apps/web`, e moram em `apps/web/.env.local` — não aqui.
# Estão listadas para quem procura saber que existem.
#
#   VITE_API_URL   origem da API quando ela não está atrás do mesmo domínio da tela.
#                  Vazia em desenvolvimento. Sem barra no fim.
#                  Exemplo: https://api.seudominio.com.br
#
# Só variável com o prefixo VITE_ chega ao pacote montado. Nunca ponha segredo nelas: o
# que vai para o pacote é público, por definição.
