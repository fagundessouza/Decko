[Unit]
Description=Decko API
Documentation=https://github.com/fagundessouza/Decko
Requires=postgresql@18-main.service
After=network-online.target postgresql@18-main.service
Wants=network-online.target

[Service]
Type=exec
User=decko
Group=decko
WorkingDirectory=/opt/decko/app
Environment=HOME=/opt/decko
EnvironmentFile=/etc/decko/decko.env
ExecStart=/usr/local/bin/uv run --frozen --no-dev uvicorn decko.main:app --host 127.0.0.1 --port 8000
Restart=always
RestartSec=5

# Nunca desistir de tentar.
#
# O padrao do systemd para aqui depois de cinco partidas em dez segundos, e deixa a
# unidade morta ate alguem mandar subir a mao. Numa caixa que fica sozinha atras de uma
# tomada, "alguem" nao existe: foi exatamente o medo depois do pico de energia de
# 17/11/2026, que derrubou a maquina duas vezes na mesma madrugada.
#
# Com zero aqui, se o banco demorar a recuperar o WAL, a API insiste ate ele estar de pe,
# em vez de desistir calada no meio da noite.
StartLimitIntervalSec=0

# A API so escuta em 127.0.0.1: quem a expoe e o tunel. Nada do Decko fica aberto
# na rede local sem passar por ele.
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/opt/decko
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes

[Install]
WantedBy=multi-user.target
